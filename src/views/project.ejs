<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (project) { %>
            <h2>
                <%= project.title %>
            </h2>
            <p>
                <%= project.description %>
            </p>
            <p><strong>Location:</strong>
                <%= project.location %>
            </p>
            <p><strong>Date:</strong>
                <%= project.date %>
            </p>
            <p><strong>Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <% if (categories.length> 0) { %>
                <p><strong>Categories:</strong></p>
                <ul class="category-tags">
                    <% categories.forEach(category=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p><strong>Categories:</strong> None assigned</p>
                    <% } %>

                        <% if (user && user.role_name==='admin' ) { %>
                            <p>
                                <a href="/edit-project/<%= project.project_id %>">Edit Project</a> |
                                <a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a>
                            </p>
                            <% } %>
                                <% } else { %>
                                    <p>Project not found.</p>
                                    <% } %>
    </main>

    <%- include('partials/footer') %>